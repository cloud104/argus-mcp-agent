# =============================================================================
# Argus Agent - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git - it contains sensitive credentials

# --- LLM API Keys ---
# Add ONLY the keys for the models you intend to use
# The application will read the key corresponding to the 'provider' defined in config/models.json

OPENAI_API_KEY='your-openai-api-key-here'
OPENAI_BASE_URL='https://api.openai.com/v1'
OPENAI_MODEL='gpt-4o'

# If using Google Gemini, uncomment:
# GOOGLE_API_KEY=your_google_api_key_here

# If using Anthropic directly, uncomment:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Elasticsearch Configuration ---
# This is the address of your Elasticsearch cluster

ES_HOST="https://your-elasticsearch-host:9200"
ES_USER="elastic"
ES_PASSWORD="your-elasticsearch-password"

# --- ChromaDB Configuration ---
# Mode: 'embedded' for local development, 'standalone' for production/containers

CHROMA_MODE=standalone
CHROMA_HOST=argus-chromadb
CHROMA_PORT=8000

# --- Environment Configuration ---

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Authentication Configuration ---
# IMPORTANT: Change these values in production!
# Generate a secure secret key with: openssl rand -hex 32

JWT_SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Default admin password (only used when creating the first admin user)
DEFAULT_ADMIN_PASSWORD=admin123

# PostgreSQL Configuration for Authentication Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus123
POSTGRES_DB=argus_auth

# Service-to-Service Authentication Token
# Used for internal communication between app and MCP server
# Generate with: openssl rand -hex 32
MCP_SERVICE_TOKEN=change-this-to-a-random-token-in-production

# --- Port Configuration (used by Docker Compose and Tilt) ---

APP_PORT=8000
MCP_SERVER_PORT=8002

# --- Internal URLs (Docker/K8s) ---
# For local development, use localhost. For containers, use service names.

MCP_SERVER_URL=http://argus-mcp-server:8002/mcp/

# --- Kubernetes Namespace (used by Tilt and Makefile) ---

K8S_NAMESPACE=argus-dev

# --- Timeout Configuration (in seconds) ---
# Control timeout behavior for external service calls and API endpoints

# Elasticsearch timeout for queries
ES_TIMEOUT=30

# API endpoint timeouts
API_TIMEOUT_INITIAL=120          # Initial log analysis
API_TIMEOUT_DEEP_DIVE=120        # Deep dive analysis
API_TIMEOUT_CHAT=120             # Chat interactions
API_TIMEOUT_LOG_EXPLAIN=30       # Single log line explanation

# =============================================================================
# Configuration Notes
# =============================================================================
#
# Health Checks:
# - The application exposes /health/live, /health/ready, and /health/startup
# - Kubernetes probes are configured to use these endpoints
# - Docker Compose healthchecks use /health/ready
#
# Retry Policies:
# - Elasticsearch calls automatically retry 3 times with exponential backoff
# - Retry behavior is configured in app/utils/resilience.py
#
# Graceful Shutdown:
# - terminationGracePeriodSeconds is set to 30s in Kubernetes deployments
# - The application properly closes ES connections on shutdown
#
# For more information, see CLAUDE.md
# =============================================================================
