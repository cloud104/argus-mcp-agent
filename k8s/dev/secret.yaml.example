# Example secret file - DO NOT commit the actual secret.yaml file
# Copy this to secret.yaml and fill in your actual values
# Then apply with: kubectl apply -f k8s/dev/secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: argus-secrets
  namespace: argus-dev
type: Opaque
stringData:
  # LLM API Keys
  OPENAI_API_KEY: "sk-..."
  GOOGLE_API_KEY: "..."
  ANTHROPIC_API_KEY: "sk-ant-..."

  # Elasticsearch credentials
  ES_HOST: "https://your-elasticsearch-host"
  ES_USER: "elastic"
  ES_PASSWORD: "your-password"

  # PostgreSQL credentials (from postgres-secret)
  POSTGRES_USER: "argus"
  POSTGRES_PASSWORD: "argus123"

  # JWT Secret Key (IMPORTANT: Generate with openssl rand -hex 32)
  JWT_SECRET_KEY: "your-secret-key-change-in-production-use-openssl-rand-hex-32"
